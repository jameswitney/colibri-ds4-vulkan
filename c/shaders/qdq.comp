#version 450
// dsv4 fp8 activation QDQ (M2-2): a bitwise replica of the CPU reference
// coli_fp8_activation_qdq_ref (deepseek_v4.c). Per block_size elements:
//   maximum = max(|x|)  floored at 1e-4
//   e = clamp(ceil_log2(maximum/448.0), -127, 127); code = e+127; scale = 2^e
//   y[i] = e4m3_decode(e4m3_encode(clamp(x[i]/scale, -448, 448))) * scale
// The dense qkv path uses block=128 (wq_a + wkv share ONE qdq pass — the _pre
// hoist); the MLA nope path uses 64. Grid = (ceil(I/block), S), one block per
// 128-thread workgroup (idle lanes contribute 0 to the max — safe, the result
// is floored at 1e-4).
//
// BITWISE contract (TEST L1): every operation is reproduced exactly:
//   - the max reduction is order-independent (max is a commutative monoid;
//     fmaxf vs GLSL max agree on finite values), so the shared-tree reduction
//     equals the CPU's sequential scan;
//   - maximum/448.0 and x/scale are correctly-rounded fp32 divisions
//     (SPIR-V OpFDiv; scale is a power of two so x/scale is exact in range);
//   - ceil_log2 via fp32 exponent/mantissa bits, matching frexpf semantics
//     (value is always a normal >= 2^-22 here, so bit extraction is exact);
//   - scale = 2^e via bit patterns, matching ldexpf(1.f, e) exactly
//     (incl. the e == -127 subnormal);
//   - the RNE E4M3FN encoder is ported bit-for-bit from coli_e4m3fn_encode
//     (subnormal branch: mag*512, truncate, ties-to-even; normal branch:
//     significand >> 20, 0x80000 half-ulp remainder, carry on 16);
//   - E4M3 decode via the same 256-entry bit-pattern LUT as qmatmul.comp.
layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly buffer X  { float x[]; };
layout(std430, binding = 1) writeonly buffer Y { float y[]; };
layout(std430, binding = 2) writeonly buffer SC { uint sc[]; };  // one UE8M0 code per block

layout(push_constant) uniform P {
    int S, I, block;
} p;

const uint E4M3_BITS[256] = uint[256](
