float e4m3_decode(uint code) { return intBitsToFloat(int(E4M3_BITS[code & 0xffu])); }

/* Bit-exact port of coli_e4m3fn_encode (RNE to the E4M3FN grid). */
uint e4m3_encode(float v) {
    uint sign = (floatBitsToUint(v) >> 31u) & 1u;
    float mag = abs(v);
    if (mag == 0.0f) return sign << 7u;
    if (mag >= 448.0f) return (sign << 7u) | 0x7eu;
    if (mag < 0.015625f) {                       // subnormal e4m3 region: m*2^-9
        float scaled = mag * 512.0f;
        uint r = uint(scaled);                   // truncate
        float fraction = scaled - float(r);
        if (fraction > 0.5f || (fraction == 0.5f && (r & 1u) != 0u)) r++;
        return (r & 0xffu) | (sign << 7u);
    }
    uint bits = floatBitsToUint(mag);
    int exponent = int((bits >> 23u) & 0xffu) - 127;
    uint significand = 0x800000u | (bits & 0x7fffffu);
    uint r = significand >> 20u;
    uint rem = significand & 0xfffffu;
    if (rem > 0x80000u || (rem == 0x80000u && (r & 1u) != 0u)) r++;
    if (r == 16u) { r = 8u; exponent++; }
    uint best = uint((exponent + 7) * 8 + int(r) - 8);
    return (best & 0xffu) | (sign << 7u);
}

/* 2^e via bit patterns, bitwise-equal to ldexpf(1.f, e) (e in [-127, 127]). */
float scale_from_code(uint code) {
    int e = int(code) - 127;
    if (e == -127) return uintBitsToFloat(0x00400000u);   // 2^-127 (subnormal)
    return uintBitsToFloat(uint(e + 127) << 23u);
}

/* ceil_log2(v) for v a normal fp32 > 0 (frexpf semantics: v = f*2^e, f in
 * [0.5,1); result e-1 iff f == 0.5 exactly, i.e. v is a power of two). */
int ceil_log2(float v) {
    uint bits = floatBitsToUint(v);
    int e = int((bits >> 23u) & 0xffu) - 127;    // unbiased exponent
    uint mant = bits & 0x7fffffu;
    return (mant == 0u) ? e : e + 1;
}

shared float mx[128];
shared uint  g_code;

void main() {
    int s = int(gl_WorkGroupID.y);
    int b = int(gl_WorkGroupID.x);
    int nblk = (p.I + p.block - 1) / p.block;
    int base = b * p.block;
    int count = min(p.block, p.I - base);
    int tid = int(gl_LocalInvocationID.x);
    float v = 0.0f;                              // idle lanes: neutral for max
    if (tid < count) v = abs(x[s * p.I + base + tid]);
    mx[tid] = v;
    barrier();
    for (int n = 64; n > 0; n >>= 1) {
        if (tid < n) mx[tid] = max(mx[tid], mx[tid + n]);
        barrier();
    }
    if (tid == 0) {
        float maximum = max(mx[0], 1e-4f);
        float ratio = maximum / 448.0f;          // fp32 div: correctly rounded
        int e = ceil_log2(ratio);
        e = clamp(e, -127, 127);
        uint code = uint(e + 127);
        g_code = code;
        sc[s * nblk + b] = code;
    }
    barrier();
    float scale = scale_from_code(g_code);
    if (tid < count) {
        int i = base + tid;
        float normalized = clamp(x[s * p.I + i] / scale, -448.0f, 448.0f);
        y[s * p.I + i] = e4m3_decode(e4m3_encode(normalized)) * scale;
    }
}
